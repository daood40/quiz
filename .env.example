# QUIZ PLATFORM — environment template. Copy to .env and fill in real values.
# NEVER commit real secrets.

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://quiz:CHANGE_ME@localhost:5432/quiz_platform
DATABASE_URL_TEST=postgres://quiz:CHANGE_ME@localhost:5432/quiz_platform_test
PG_POOL_MAX=10

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# --- Guest mode ---
GUEST_MODE_ENABLED=true
GUEST_MAX_QUESTIONS=10

# --- Jobs ---
JOBS_ENABLED=true

# --- Web (Vite) ---
VITE_API_BASE=http://localhost:3001/api/v1
