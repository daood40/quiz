# QUIZ PLATFORM — environment template. Copy to .env and fill in real values.
# NEVER commit real secrets.

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://quiz:CHANGE_ME@localhost:5432/quiz_platform
DATABASE_URL_TEST=postgres://quiz:CHANGE_ME@localhost:5432/quiz_platform_test
PG_POOL_MAX=10

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Reverse proxy / PaaS ---
# Number of trusted proxy hops in front of the API (Render/Fly/Railway/nginx: 1). Leave empty when exposed directly.
TRUST_PROXY=

# --- Observability ---
# METRICS_TOKEN=change-me        # protects GET /metrics (Prometheus) when the port is reachable
# ERROR_WEBHOOK_URL=             # every unhandled 5xx / failed job is POSTed as JSON (Slack, Discord, any relay)
# SENTRY_DSN=                    # optional; also run `npm i @sentry/node -w server`

# --- AI gateway (server-side only; disabled unless both are set) ---
# AI_PROVIDER=anthropic          # or `mock` for local development/tests
# AI_API_KEY=                    # never exposed to the web client
# AI_MODEL=claude-opus-5
# AI_DAILY_PER_USER=20           # draft requests per editor per day
# AI_DAILY_PLATFORM=500          # draft requests per day, whole platform

# --- Backups (scripts/backup.sh) ---
# BACKUP_DIR=./backups
# RETENTION_DAYS=14
# BACKUP_S3_URI=s3://bucket/quiz  # or BACKUP_COPY_CMD='rclone copy {file} remote:quiz'

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# --- Guest mode ---
GUEST_MODE_ENABLED=true
GUEST_MAX_QUESTIONS=10

# --- Jobs ---
JOBS_ENABLED=true

# --- First boot (hosting) ---
# SEED_ON_BOOT=true      # create admin + categories + starter question bank on start (idempotent)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_QUESTIONS=false   # skip the 150+ starter questions if you import your own bank

# --- Web (Vite) ---
VITE_API_BASE=http://localhost:3001/api/v1
