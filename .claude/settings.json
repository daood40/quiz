{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx vite build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(actionlint*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./server/.env)",
      "Read(./server/.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(**/key.properties)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)"
    ]
  }
}
